{
  "info": {
    "name": "E-commerce MS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Every request goes through the API gateway (gatewayUrl). To debug one service directly, point customerUrl or productUrl at its own port."
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8222/api/v1"
    },
    {
      "key": "customerUrl",
      "value": "{{gatewayUrl}}",
      "description": "Direct (debug only): http://localhost:8090/api/v1"
    },
    {
      "key": "productUrl",
      "value": "{{gatewayUrl}}",
      "description": "Direct (debug only): http://localhost:8050/api/v1"
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Customer",
      "item": [
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{customerUrl}}/customers",
              "host": [
                "{{customerUrl}}"
              ],
              "path": [
                "customers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Ada\",\n  \"lastname\": \"Lovelace\",\n  \"email\": \"ada@example.com\",\n  \"address\": {\n    \"street\": \"Main Street\",\n    \"houseNumber\": \"12\",\n    \"zipCode\": \"75001\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('customerId', pm.response.json().id);",
                  "pm.test('Location points to the gateway', () => pm.expect(pm.response.headers.get('Location')).to.include(':8222/'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create duplicate email (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{customerUrl}}/customers",
              "host": [
                "{{customerUrl}}"
              ],
              "path": [
                "customers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Ada\",\n  \"lastname\": \"Lovelace\",\n  \"email\": \"ada@example.com\",\n  \"address\": {\n    \"street\": \"Main Street\",\n    \"houseNumber\": \"12\",\n    \"zipCode\": \"75001\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create invalid (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{customerUrl}}/customers",
              "host": [
                "{{customerUrl}}"
              ],
              "path": [
                "customers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"\",\n  \"lastname\": \"L\",\n  \"email\": \"not-an-email\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 with field errors', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().errors).to.have.property('email'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Find by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{customerUrl}}/customers/{{customerId}}",
              "host": [
                "{{customerUrl}}"
              ],
              "path": [
                "customers",
                "{{customerId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update customer",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{customerUrl}}/customers/{{customerId}}",
              "host": [
                "{{customerUrl}}"
              ],
              "path": [
                "customers",
                "{{customerId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Ada\",\n  \"lastname\": \"King\",\n  \"email\": \"ada@example.com\",\n  \"address\": {\n    \"street\": \"Baker Street\",\n    \"houseNumber\": \"221B\",\n    \"zipCode\": \"NW1\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('lastname updated', () => pm.expect(pm.response.json().lastname).to.eql('King'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Find all",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{customerUrl}}/customers",
              "host": [
                "{{customerUrl}}"
              ],
              "path": [
                "customers"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Exists",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{customerUrl}}/customers/exists/{{customerId}}",
              "host": [
                "{{customerUrl}}"
              ],
              "path": [
                "customers",
                "exists",
                "{{customerId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('true', () => pm.expect(pm.response.json()).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete customer",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{customerUrl}}/customers/{{customerId}}",
              "host": [
                "{{customerUrl}}"
              ],
              "path": [
                "customers",
                "{{customerId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Find deleted (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{customerUrl}}/customers/{{customerId}}",
              "host": [
                "{{customerUrl}}"
              ],
              "path": [
                "customers",
                "{{customerId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Product",
      "item": [
        {
          "name": "Find all (seeded)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{productUrl}}/products",
              "host": [
                "{{productUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('12+ products', () => pm.expect(pm.response.json().length).to.be.at.least(12));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{productUrl}}/products",
              "host": [
                "{{productUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Keychron Q1\",\n  \"description\": \"Aluminium 75% keyboard\",\n  \"availableQuantity\": 3,\n  \"price\": 169.0,\n  \"categoryId\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('productId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Find by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{productUrl}}/products/{{productId}}",
              "host": [
                "{{productUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('category included', () => pm.expect(pm.response.json().categoryName).to.eql('Keyboards'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create with unknown category (404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{productUrl}}/products",
              "host": [
                "{{productUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"X\",\n  \"description\": \"Y\",\n  \"availableQuantity\": 1,\n  \"price\": 1,\n  \"categoryId\": 42\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Purchase 2 units",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{productUrl}}/products/purchase",
              "host": [
                "{{productUrl}}"
              ],
              "path": [
                "products",
                "purchase"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"productId\": {{productId}},\n    \"quantity\": 2\n  }\n]"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Purchase more than stock (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{productUrl}}/products/purchase",
              "host": [
                "{{productUrl}}"
              ],
              "path": [
                "products",
                "purchase"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"productId\": {{productId}},\n    \"quantity\": 5\n  }\n]"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 with shortages', () => { pm.response.to.have.status(409); pm.expect(pm.response.json().shortages).to.have.length(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Purchase invalid quantity (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{productUrl}}/products/purchase",
              "host": [
                "{{productUrl}}"
              ],
              "path": [
                "products",
                "purchase"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"productId\": 1,\n    \"quantity\": 0\n  }\n]"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Stock is now 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{productUrl}}/products/{{productId}}",
              "host": [
                "{{productUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('stock 1', () => pm.expect(pm.response.json().availableQuantity).to.eql(1));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}