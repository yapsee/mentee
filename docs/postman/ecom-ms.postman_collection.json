{
  "info": {
    "name": "E-commerce MS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the Customer folder top to bottom. Day 5 switches customerUrl to the gateway."
  },
  "variable": [
    {
      "key": "customerUrl",
      "value": "http://localhost:8090/api/v1"
    },
    {
      "key": "customerId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Customer",
      "item": [
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{customerUrl}}/customers",
              "host": [
                "{{customerUrl}}"
              ],
              "path": [
                "customers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Ada\",\n  \"lastname\": \"Lovelace\",\n  \"email\": \"ada@example.com\",\n  \"address\": {\n    \"street\": \"Main Street\",\n    \"houseNumber\": \"12\",\n    \"zipCode\": \"75001\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('customerId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create duplicate email (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{customerUrl}}/customers",
              "host": [
                "{{customerUrl}}"
              ],
              "path": [
                "customers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Ada\",\n  \"lastname\": \"Lovelace\",\n  \"email\": \"ada@example.com\",\n  \"address\": {\n    \"street\": \"Main Street\",\n    \"houseNumber\": \"12\",\n    \"zipCode\": \"75001\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create invalid (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{customerUrl}}/customers",
              "host": [
                "{{customerUrl}}"
              ],
              "path": [
                "customers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"\",\n  \"lastname\": \"L\",\n  \"email\": \"not-an-email\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 with field errors', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().errors).to.have.property('email'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Find by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{customerUrl}}/customers/{{customerId}}",
              "host": [
                "{{customerUrl}}"
              ],
              "path": [
                "customers",
                "{{customerId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update customer",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{customerUrl}}/customers/{{customerId}}",
              "host": [
                "{{customerUrl}}"
              ],
              "path": [
                "customers",
                "{{customerId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Ada\",\n  \"lastname\": \"King\",\n  \"email\": \"ada@example.com\",\n  \"address\": {\n    \"street\": \"Baker Street\",\n    \"houseNumber\": \"221B\",\n    \"zipCode\": \"NW1\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('lastname updated', () => pm.expect(pm.response.json().lastname).to.eql('King'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Find all",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{customerUrl}}/customers",
              "host": [
                "{{customerUrl}}"
              ],
              "path": [
                "customers"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Exists",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{customerUrl}}/customers/exists/{{customerId}}",
              "host": [
                "{{customerUrl}}"
              ],
              "path": [
                "customers",
                "exists",
                "{{customerId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('true', () => pm.expect(pm.response.json()).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete customer",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{customerUrl}}/customers/{{customerId}}",
              "host": [
                "{{customerUrl}}"
              ],
              "path": [
                "customers",
                "{{customerId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Find deleted (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{customerUrl}}/customers/{{customerId}}",
              "host": [
                "{{customerUrl}}"
              ],
              "path": [
                "customers",
                "{{customerId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}