# Copy to .env and adjust. docker compose reads .env automatically.

# PostgreSQL (product, order, payment services)
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom
# Host port. 5433 because a local PostgreSQL already uses 5432 on this machine.
POSTGRES_PORT=5433

# pgAdmin
PGADMIN_EMAIL=admin@ecom.com
PGADMIN_PASSWORD=admin

# MongoDB (customer, notification services)
MONGO_USER=ecom
MONGO_PASSWORD=ecom

# mongo-express basic auth
ME_USER=admin
ME_PASSWORD=admin
